# Base URL of erebus-api, INCLUDING the /v1 prefix (LLD §12.2).
# Preview and production use an absolute URL; local development uses the
# root-relative "/v1" so the Vite dev proxy can forward it (ADR-003).
VITE_API_BASE_URL=https://erebus-api.example.com/v1

# Axios request timeout in milliseconds. Optional — defaults to 8000.
VITE_REQUEST_TIMEOUT_MS=8000
